@startuml plantuml_class_diagram
skinparam classAttributeIconSize 0

class ValidationService {
  +config : dict
  +db : Connection
  +process_file(file_bytes, file_name) : dict
  +close()
}
class PolicyEvaluator {
  +thresholds : dict
  +evaluate(failures) : str
  +get_reason(failures) : str
}
class engine <<module>> {
  +CHECKS : dict
  +load_config(path) : dict
  +infer_config(df, thresholds) : tuple
  +run_checks(df, config) : tuple
}
class store <<module>> {
  +connect(path) : Connection
  +save_run(conn, file_name, rows_checked, failures, file_hash, status, dataset) : int
  +history(conn, limit) : DataFrame
  +rule_trend(conn, rule_name, limit) : DataFrame
}
class "app.py (Streamlit UI)" as UI

UI --> ValidationService : uses
UI --> store : history()
ValidationService --> engine : uses
ValidationService *-- PolicyEvaluator : creates
ValidationService --> store : save_run()
@enduml
